# --- PostgreSQL ---
POSTGRES_USER=fur
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=fur

# --- API ---
# Token que la aplicación emisora debe enviar en el header X-API-Key. También
# es la clave que se pide en el visor para iniciar sesión y poder ver los datos.
API_KEY=cambia-esta-clave
# Firma la cookie de sesión del visor. Si se deja vacío, se usa API_KEY.
SESSION_SECRET=
# En True si el sitio se sirve por HTTPS (recomendado en prod).
COOKIE_SECURE=false
# Orígenes permitidos para CORS (dominio del frontend). "*" permite todos, pero
# con cookies de sesión (allow_credentials) solo funciona si el frontend y la
# API comparten origen (p. ej. vía el proxy de nginx en docker-compose). Si el
# frontend vive en otro dominio, pon aquí ese dominio explícito.
CORS_ORIGINS=*

# --- Directorio de importación local ---
# Ruta en el servidor donde la app emisora deja los FUR (frenos, suspensión,
# alineación, ruidos) como archivos .json. Se revisa cada BUFFER_INTERVALO_SEG.
BUFFER_DIR=/home/cedac/app/buffer_pruebas
BUFFER_INTERVALO_SEG=15

# --- Frontend (build-time) ---
# Dominio público de la API en producción. Déjalo vacío si el frontend y la API
# comparten host/proxy. Ej: https://api.midominio.com
VITE_API_BASE=

# Solo para conexión directa fuera de Docker (uvicorn local):
# DATABASE_URL=postgresql+psycopg://fur:fur@localhost:5432/fur
