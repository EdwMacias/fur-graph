# --- PostgreSQL ---
POSTGRES_USER=fur
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=fur

# --- API ---
# Token que la aplicación emisora debe enviar en el header X-API-Key.
API_KEY=cambia-esta-clave
# Orígenes permitidos para CORS (dominio del frontend). "*" permite todos.
CORS_ORIGINS=*

# --- Frontend (build-time) ---
# Dominio público de la API en producción. Déjalo vacío si el frontend y la API
# comparten host/proxy. Ej: https://api.midominio.com
VITE_API_BASE=

# Solo para conexión directa fuera de Docker (uvicorn local):
# DATABASE_URL=postgresql+psycopg://fur:fur@localhost:5432/fur
